# Copy to .env and fill in. .env is never committed.
#
# Hosts live here rather than in the source. A base URL baked into a binary
# is a third party you cannot redirect without a rebuild: not for a staging
# endpoint, not for a recorded fixture, not when a provider moves. Nothing
# below has a default in the code - a missing value fails at startup with
# the variable named, rather than silently reaching for someone's server.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=robasko
POSTGRES_PASSWORD=robasko
POSTGRES_DB=robasko
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
AGENTD_PORT=8080

# Where private artifacts are written. Defaults to $XDG_DATA_HOME/robasko,
# else ~/.local/share/robasko. Set this to put them somewhere backed up.
#ROBASKO_DATA_DIR=

# ---------------------------------------------------------------------------
# Job sources (SPEC.md 15)
#
# Sources are numbered, not named. Which providers this runs against is
# configuration, not something the repository announces: the names belong in
# .env together with the credentials.
#
# NAME is the identifier stored in the `source` column and used in saved
# searches, so it must stay stable once vacancies exist under it.
# BASE_URL goes up to but not including the resource path, no trailing slash.
# API_ID is only needed by providers that use a two-part credential.
#
# Add further slots by continuing the numbering.
# ---------------------------------------------------------------------------

SOURCE_1_NAME=
SOURCE_1_BASE_URL=
SOURCE_1_API_KEY=
SOURCE_1_API_ID=

SOURCE_2_NAME=
SOURCE_2_BASE_URL=
SOURCE_2_API_KEY=
SOURCE_2_API_ID=

SOURCE_3_NAME=
SOURCE_3_BASE_URL=
SOURCE_3_API_KEY=
SOURCE_3_API_ID=

# ---------------------------------------------------------------------------
# Model (SPEC.md 16)
# ---------------------------------------------------------------------------
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# Required only when the key is not scoped to a workspace. Such a key is
# rejected with a 400 that names this header.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5-5
